<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="trivialGeografico.MainPage"
             Title="Principal">

    <Grid>
        <!-- Imagen Mapa de fondo -->
        <Image Source="europa.jpg" 
       Aspect="AspectFill" />

        <!-- Capa de oscurecimiento -->
        <BoxView Color="#000000" Opacity="0.6" />

        <VerticalStackLayout Spacing="30" Padding="30" VerticalOptions="Center">

            <Label Text="Trivial Geográfico de Europa" 
                   FontSize="32" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="White"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Elige una opción pulsando un botón:" 
                   FontSize="18" 
                   HorizontalOptions="Center" 
                   TextColor="#E0E0E0"/>

            <Button Text="Capitales de 10 países" 
                    Style="{StaticResource ActionButton}" 
                    Clicked="OnCapitalesClicked"/>

            <Button Text="Países de 10 capitales" 
                    Style="{StaticResource ActionButton}" 
                    Clicked="OnPaisesClicked"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>